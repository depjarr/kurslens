# Salin file ini jadi .env, lalu isi API key-nya.

# ---- Pilih AI: gemini (ada jatah gratis) atau claude (berbayar) ----
AI_PROVIDER=gemini

# Google AI Studio — buat key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opsional. Default: gemini-3.5-flash-lite (cepat & hemat).
# Lebih akurat untuk tulisan kecil: gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Claude (Anthropic) — https://console.anthropic.com, berbayar per pemakaian
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

PORT=3000
